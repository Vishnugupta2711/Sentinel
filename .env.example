# ═══════════════════════════════════════════════════════════════
# Sentinel — Environment Configuration Template
# Copy to .env and customize: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# Application
APP_TITLE=Sentinel
APP_VERSION=1.0.0
APP_ENVIRONMENT=production
APP_DEBUG=false
ENV=production

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80



# Kafka
KAFKA_BROKER=kafka:9092

# Redis
REDIS_URL=redis://redis:6379

# ChromaDB
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=<CHANGE_ME>
CHROMA_TENANT=00c4fee5-4641-4e88-a58d-2217da9a390b
CHROMA_DATABASE=Sentinal chromadb

# Security
SECURITY_JWT_SECRET=<GENERATE_RANDOM_256_BIT_KEY>
SECURITY_CORS_ORIGINS=["*"]

# Logging
LOGGING_LEVEL=INFO
LOGGING_FORMAT=json

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost/ws

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=<CHANGE_ME>
